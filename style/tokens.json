{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "TRAE Design Tokens",
  "version": "1.0.0",
  "description": "Design tokens ufficiali per l'interfaccia TRAE. Palette desaturata, dark-first, glassmorphism discreto.",
  "meta": {
    "theme": "dark",
    "font": "Inter",
    "grid": "4px",
    "author": "TRAE Design System"
  },
  "color": {
    "surface": {
      "bg":            { "value": "#0A0A0B", "type": "color", "description": "Sfondo applicazione" },
      "bgElev":        { "value": "#0F0F12", "type": "color", "description": "Superficie elevata" },
      "glass":         { "value": "rgba(20, 20, 23, 0.55)", "type": "color", "description": "Superficie glass" },
      "glassStrong":   { "value": "rgba(20, 20, 23, 0.82)", "type": "color", "description": "Superficie glass densa (dropdown/modal)" },
      "hover":         { "value": "rgba(255, 255, 255, 0.045)", "type": "color" },
      "active":        { "value": "rgba(255, 255, 255, 0.075)", "type": "color" }
    },
    "border": {
      "base":   { "value": "rgba(255, 255, 255, 0.07)", "type": "color" },
      "strong": { "value": "rgba(255, 255, 255, 0.13)", "type": "color" },
      "bright": { "value": "rgba(255, 255, 255, 0.20)", "type": "color" }
    },
    "text": {
      "primary":   { "value": "#EDEDEF", "type": "color" },
      "secondary": { "value": "#98989F", "type": "color" },
      "muted":     { "value": "#66666E", "type": "color" },
      "ghost":     { "value": "#44444A", "type": "color" }
    },
    "accent": {
      "base": { "value": "#D97757", "type": "color", "description": "Accento terracotta" },
      "soft": { "value": "rgba(217, 119, 87, 0.12)", "type": "color" },
      "line": { "value": "rgba(217, 119, 87, 0.35)", "type": "color" }
    },
    "semantic": {
      "success":      { "value": "#7FB894", "type": "color" },
      "successSoft":  { "value": "rgba(127, 184, 148, 0.12)", "type": "color" },
      "danger":       { "value": "#E5484D", "type": "color" },
      "dangerSoft":   { "value": "rgba(229, 72, 77, 0.12)", "type": "color" },
      "warning":      { "value": "#E5B84D", "type": "color" },
      "warningSoft":  { "value": "rgba(229, 184, 77, 0.12)", "type": "color" },
      "info":         { "value": "#6B94D9", "type": "color" },
      "infoSoft":     { "value": "rgba(107, 148, 217, 0.12)", "type": "color" }
    }
  },
  "theme": {
    "light": {
      "description": "Overrides applied when [data-theme=\"light\"] is set on the root element (dark is the default). Mirrors tokens.css.",
      "color": {
        "surface": {
          "bg":          { "value": "#F7F7F8", "type": "color" },
          "bgElev":      { "value": "#FFFFFF", "type": "color" },
          "glass":       { "value": "rgba(255, 255, 255, 0.72)", "type": "color" },
          "glassStrong": { "value": "rgba(255, 255, 255, 0.90)", "type": "color" },
          "hover":       { "value": "rgba(0, 0, 0, 0.04)", "type": "color" },
          "active":      { "value": "rgba(0, 0, 0, 0.07)", "type": "color" }
        },
        "border": {
          "base":   { "value": "rgba(0, 0, 0, 0.10)", "type": "color" },
          "strong": { "value": "rgba(0, 0, 0, 0.16)", "type": "color" },
          "bright": { "value": "rgba(0, 0, 0, 0.24)", "type": "color" }
        },
        "text": {
          "primary":   { "value": "#16161A", "type": "color" },
          "secondary": { "value": "#55555E", "type": "color" },
          "muted":     { "value": "#85858E", "type": "color" },
          "ghost":     { "value": "#A8A8B0", "type": "color" }
        },
        "accent": {
          "base": { "value": "#C4633F", "type": "color" },
          "soft": { "value": "rgba(196, 99, 63, 0.12)", "type": "color" },
          "line": { "value": "rgba(196, 99, 63, 0.35)", "type": "color" }
        },
        "semantic": {
          "success":     { "value": "#3E8E5A", "type": "color" },
          "successSoft": { "value": "rgba(62, 142, 90, 0.12)", "type": "color" },
          "danger":      { "value": "#CE3B40", "type": "color" },
          "dangerSoft":  { "value": "rgba(206, 59, 64, 0.12)", "type": "color" },
          "warning":     { "value": "#B08428", "type": "color" },
          "warningSoft": { "value": "rgba(176, 132, 40, 0.14)", "type": "color" },
          "info":        { "value": "#3E6DB5", "type": "color" },
          "infoSoft":    { "value": "rgba(62, 109, 181, 0.12)", "type": "color" }
        }
      }
    }
  },
  "radius": {
    "xs":   { "value": "6px",  "type": "dimension" },
    "sm":   { "value": "8px",  "type": "dimension" },
    "md":   { "value": "10px", "type": "dimension" },
    "lg":   { "value": "14px", "type": "dimension" },
    "xl":   { "value": "18px", "type": "dimension" },
    "full": { "value": "999px","type": "dimension" }
  },
  "space": {
    "1":  { "value": "4px",  "type": "dimension" },
    "2":  { "value": "8px",  "type": "dimension" },
    "3":  { "value": "12px", "type": "dimension" },
    "4":  { "value": "16px", "type": "dimension" },
    "5":  { "value": "20px", "type": "dimension" },
    "6":  { "value": "24px", "type": "dimension" },
    "8":  { "value": "32px", "type": "dimension" },
    "10": { "value": "40px", "type": "dimension" },
    "12": { "value": "48px", "type": "dimension" }
  },
  "font": {
    "family": {
      "sans": { "value": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif", "type": "fontFamily" },
      "mono": { "value": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "type": "fontFamily" }
    },
    "size": {
      "display": { "value": "34px",   "type": "dimension" },
      "h1":      { "value": "24px",   "type": "dimension" },
      "h2":      { "value": "18px",   "type": "dimension" },
      "h3":      { "value": "15px",   "type": "dimension" },
      "body":    { "value": "14px",   "type": "dimension" },
      "bodySm":  { "value": "12.5px", "type": "dimension" },
      "caption": { "value": "11.5px", "type": "dimension" },
      "label":   { "value": "10.5px", "type": "dimension" },
      "mono":    { "value": "12px",   "type": "dimension" }
    },
    "weight": {
      "regular":  { "value": 400, "type": "fontWeight" },
      "medium":   { "value": 500, "type": "fontWeight" },
      "semibold": { "value": 550, "type": "fontWeight" },
      "bold":     { "value": 600, "type": "fontWeight" }
    },
    "lineHeight": {
      "tight":   { "value": 1.2, "type": "number" },
      "normal":  { "value": 1.5, "type": "number" },
      "relaxed": { "value": 1.6, "type": "number" }
    },
    "letterSpacing": {
      "tight":   { "value": "-0.032em", "type": "dimension" },
      "snug":    { "value": "-0.02em",  "type": "dimension" },
      "normal":  { "value": "-0.005em", "type": "dimension" },
      "label":   { "value": "0.09em",   "type": "dimension" }
    }
  },
  "motion": {
    "ease": {
      "base":   { "value": "cubic-bezier(0.22, 1, 0.36, 1)", "type": "cubicBezier" },
      "alt":    { "value": "cubic-bezier(0.4, 0, 0.2, 1)",    "type": "cubicBezier" }
    },
    "duration": {
      "fast": { "value": "140ms", "type": "duration" },
      "base": { "value": "220ms", "type": "duration" },
      "slow": { "value": "380ms", "type": "duration" },
      "deco": { "value": "620ms", "type": "duration" }
    }
  },
  "shadow": {
    "sm": {
      "value": "0 1px 2px rgba(0,0,0,0.35)",
      "type": "boxShadow"
    },
    "md": {
      "value": "0 8px 24px -8px rgba(0,0,0,0.6)",
      "type": "boxShadow"
    },
    "lg": {
      "value": "0 24px 60px -20px rgba(0,0,0,0.85)",
      "type": "boxShadow"
    },
    "glow": {
      "value": "0 0 0 4px rgba(255,255,255,0.02)",
      "type": "boxShadow"
    }
  },
  "blur": {
    "glass":       { "value": "20px", "type": "dimension" },
    "glassStrong": { "value": "28px", "type": "dimension" },
    "sidebar":     { "value": "24px", "type": "dimension" }
  },
  "zIndex": {
    "base":    { "value": 0,    "type": "number" },
    "sticky":  { "value": 10,   "type": "number" },
    "sidebar": { "value": 20,   "type": "number" },
    "dropdown":{ "value": 100,  "type": "number" },
    "modal":   { "value": 1000, "type": "number" },
    "toast":   { "value": 2000, "type": "number" }
  }
}