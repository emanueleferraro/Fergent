{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fergents.dev/schema/workflow.schema.json",
  "title": "Fergents Workflow",
  "description": "A Fergents workflow document (Phase 5 spec §1.8).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "triggers", "nodes"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable, unique workflow id."
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "default": "0.1.0"
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "permissions": { "$ref": "#/$defs/permissions" },
    "variables": { "type": "object" },
    "triggers": {
      "type": "array",
      "items": { "$ref": "#/$defs/trigger" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "app": { "$ref": "#/$defs/app" }
  },
  "$defs": {
    "permissions": {
      "type": "object",
      "description": "Requested permission categories; a boolean grant or a scope list.",
      "additionalProperties": {
        "oneOf": [
          { "type": "boolean" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": {
          "enum": ["manual", "ai", "cron", "webhook", "file", "event"]
        },
        "description": { "type": "string" },
        "schedule": { "type": "string" },
        "timezone": { "type": "string" },
        "catch_up": { "enum": ["skip", "run_once", "run_all"] },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 4 },
        "path": { "type": "string" },
        "method": { "type": "string" },
        "auth": { "enum": ["bearer"] },
        "events": {
          "type": "array",
          "items": { "enum": ["create", "modify", "delete", "rename"] }
        },
        "topic": { "type": "string" },
        "filter": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "cron" } } },
          "then": { "required": ["schedule"] }
        },
        {
          "if": { "properties": { "kind": { "const": "webhook" } } },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "kind": { "const": "file" } } },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "kind": { "const": "event" } } },
          "then": { "required": ["topic"] }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "$ref": "#/$defs/nodeType" },
        "config": { "type": "object" },
        "inputs": { "type": "object" },
        "outputs": { "type": "object" },
        "retry": { "$ref": "#/$defs/retry" },
        "timeout_s": { "type": "integer", "minimum": 1 },
        "on_error": { "enum": ["fail", "continue", "retry", "compensate"] },
        "resume": { "enum": ["skip", "retry", "fail"] }
      }
    },
    "nodeType": {
      "oneOf": [
        {
          "enum": [
            "trigger",
            "llm",
            "tool",
            "agent",
            "code",
            "http",
            "condition",
            "loop",
            "subworkflow",
            "human",
            "transform",
            "end"
          ]
        },
        {
          "type": "string",
          "pattern": "^plugin:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._-]*$"
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "from_port": { "type": "string" },
        "to": { "type": "string" },
        "to_port": { "type": "string" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": { "type": "integer", "minimum": 0, "default": 0 },
        "backoff_ms": { "type": "integer", "minimum": 0, "default": 0 },
        "backoff_multiplier": { "type": "number", "minimum": 1, "default": 1 },
        "jitter": { "type": "boolean", "default": false },
        "retry_on": { "type": "array", "items": { "type": "string" } }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "icon": {
          "type": "string",
          "description": "A shell icon-set name, never a URL.",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/appInput" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/appOutput" }
        },
        "layout": {
          "type": "array",
          "items": { "$ref": "#/$defs/appBlock" }
        }
      }
    },
    "appInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": {
          "enum": ["string", "number", "boolean", "array", "select", "markdown"]
        },
        "label": { "type": "string" },
        "default": {},
        "required": { "type": "boolean", "default": false },
        "options": { "type": "array", "items": { "type": "string" } }
      }
    },
    "appOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "enum": ["markdown", "text", "json", "table", "link"] },
        "label": { "type": "string" }
      }
    },
    "appBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "form",
            "button",
            "output",
            "history",
            "markdown",
            "text",
            "divider",
            "columns"
          ]
        },
        "fields": { "type": "array", "items": { "type": "string" } },
        "label": { "type": "string" },
        "action": { "enum": ["run"] },
        "ref": { "type": "string" },
        "text": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1 },
        "columns": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
